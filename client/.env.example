# Copy this file to .env and fill in real values.
# Vite only exposes variables starting with VITE_ to the browser, so never put secrets here.

# Where the API lives (defaults to http://localhost:5000 if not set)
VITE_API_URL=http://localhost:5000

# "Sign in with Google" (optional): same OAuth Client ID as GOOGLE_CLIENT_ID in server/.env
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
