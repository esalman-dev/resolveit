# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection (used once the database is set up)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/resolveit

# Secret key for signing login tokens (JWTs). Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# "Sign in with Google": OAuth Client ID from Google Cloud Console (optional).
# Must match VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=

# Production only: number of proxies in front of the API (Vercel + Render), so rate limits see real visitor IPs.
# Leave unset for local development.
# TRUST_PROXY=2

# AI help (Get help suggestions). Without a key, Get help still works as a plain ticket form.
# Create a key in the Claude Console and set a monthly spending limit there.
ANTHROPIC_API_KEY=
# Optional: which model answers (default claude-haiku-5-5). Example: AI_MODEL=claude-opus-5-5
# AI_MODEL=
# Optional: AI requests allowed per rolling 24 hours, shared by Get help and Ask IT
# (defaults 20 per person, 300 for the site).
# AI_DAILY_LIMIT_PER_USER=20
# AI_DAILY_LIMIT_SITE=300
